---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DiagramZoom from '../components/DiagramZoom.astro';
import { SITE, canonical } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  tier?: '1' | '2';
  pageMeta?: {
    date?: Date;
    updated?: Date;
    revised?: Date;
    license?: string;
    passageRef?: string;
  };
}
const { title, description, tier = '2', pageMeta } = Astro.props;
const canonicalURL = canonical(Astro.url.pathname);
const citeYear = pageMeta?.date?.getFullYear();
// Effective revision date: the standard's `revised` field, falling back to the
// legacy `updated` field for any template not yet migrated. Drives both the
// print citation and the schema.org dateModified.
const revisedDate = pageMeta?.revised ?? pageMeta?.updated;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description}
      datePublished={pageMeta?.date} dateModified={revisedDate} />
  </head>
  <body>
    <Header tier={tier} />
    <main>
      <slot />
      <!-- Citation block rendered only in print, at document end. -->
      <div class="print-citation">
        {pageMeta?.passageRef && <div>John {pageMeta.passageRef}</div>}
        {pageMeta?.date && <div>Published {pageMeta.date.toISOString().slice(0, 10)}</div>}
        {revisedDate && <div>Revised {revisedDate.toISOString().slice(0, 10)}</div>}
        <div>{pageMeta?.license ?? SITE.licenseName} · {SITE.author}</div>
        <div>{canonicalURL}</div>
      </div>
    </main>
    <Footer citeYear={citeYear} />
    <DiagramZoom />
    <!-- GoatCounter — privacy-first analytics, no cookies, no banner needed.
         Pageviews site-wide; download counting via data-goatcounter-click on
         the Teaching Aids download buttons (count.js binds those itself).
         A visit arriving from a campaign link carries one tag and is
         recorded as its own path (path + '?tag'): ?ys YouTube Shorts,
         ?yv YouTube videos, ?fr Facebook Reels; ?q and ?c are kept as legacy
         campaigns. First match wins, current campaigns before legacy. Any
         other parameter (utm_*, fbclid, …) is dropped, as count.js already
         cuts the path back to the canonical URL. -->
    {SITE.goatcounter && (
      <script is:inline set:html={
        `window.goatcounter = { path: function (p) {
  var s = new URLSearchParams(location.search);
  var t = ['ys', 'yv', 'fr', 'q', 'c'].find(function (k) { return s.has(k); });
  return t ? p + '?' + t : p;
} };`
      } />
    )}
    {SITE.goatcounter && (
      <script
        is:inline
        data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>
