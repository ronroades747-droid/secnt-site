---
// Teaching Aids landing — the section home for the shorts resource-page class
// (Shorts Program Plan §2; Shorts Web Dev Handoff, 19 Aug 2026, §2 Route 2).
// Lists published cycle pages; grows cycle by cycle, same incremental-
// exposure discipline as Commentaries and Articles. The intro line is
// Commentary Production's supplied wording (handoff memo §2).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slideCycleUrl, isVisible } from '../../lib/site';
import AudienceChip from '../../components/AudienceChip.astro';

const cycles = (await getCollection('slideCycles'))
  .filter(isVisible)
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout tier="1" title="Teaching Aids"
  description="Projectable slides and teaching notes from the SECNT commentaries — free to use in church and in class.">
  <div class="reading reading--wide">
    <h1>Teaching Aids</h1>
    <p>Projectable slides and teaching notes from the SECNT commentaries — free to use in church and in class.</p>
    <!-- Audience explainer (supplied wording, memo §2) — doubles as the chip
         legend: the category names render as their chips. -->
    <p class="audience-legend">
      Every slide is tagged with the hearer it was built for — the person whose
      “wait, really?” it is meant to earn.
      <AudienceChip audience="for-everyone" /> means no Bible background is needed.
      <AudienceChip audience="new-to-the-bible" /> assumes only the famous verses.
      <AudienceChip audience="familiar-with-scripture" /> is the regular churchgoer
      who knows the passage as usually translated.
      <AudienceChip audience="students-and-teachers" /> is for those who handle the
      text closely — and every slide also serves the audiences beyond its tag: the
      tag is the floor, not the ceiling.
    </p>
    {cycles.length === 0 ? (
      <p>No teaching aids published yet.</p>
    ) : (
      <nav class="section-toc" aria-label="Teaching aids by passage">
        <ol>
          {cycles.map((c) => (
            <li>
              <a href={slideCycleUrl(c.id)}>
                <span class="toc-title">{c.data.title}</span>
                <span class="toc-desc">{c.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </div>
</BaseLayout>
