---
// Cycle index — Route 2 of the Editor's two-routes ruling (Shorts Web Dev
// Handoff, 19 Aug 2026, §2): a short introduction (the entry body, supplied
// by Commentary Production) and the list of the cycle's slide pages, each
// link resolving to the same canonical URL the QR uses. Slides not yet live
// are listed with their committed publish date — working title + date,
// unlinked until live — so the cycle page is the run's public calendar. That
// is why this template reads the full slides collection, drafts included,
// by design (metadata only; draft pages themselves are not built).
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import PageDates from './PageDates.astro';
import { slideUrl, isVisible, formatDate } from '../lib/site';
import { SLIDE_IDS } from '../lib/slide-ids';
import AudienceChip from './AudienceChip.astro';

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

// The list is ordered by RUN ORDER, not by `scheduled`.
//
// `scheduled` was the sort key until 23 Aug 2026, and it does not hold. It is
// the Editor's field (Loop Rev 7) and he sets it at the flip, so two slides
// can carry the same date: slots 3 and 4 both read 2026-08-22, the sort tied,
// and the tie fell to the collection's id order — alphabetical, `communion-`
// before `genesis-` — which put slot 4 ahead of slot 3 on the public calendar.
// The `NN-` filename prefix does not break the tie, because `generateId`
// strips it before the collection is keyed.
//
// SLIDE_IDS is the run order (Subject Index, Editor-approved 19 Aug 2026), so
// the list now reads in the order the run publishes whatever any date says.
// NOTE: this makes the ORDER of SLIDE_IDS load-bearing, where its own header
// calls the order documentation — re-sequencing the run now means re-ordering
// that list. The header is amended to match.
const runOrder = new Map(SLIDE_IDS.map((id, i) => [id, i]));
const slides = (await getCollection('slides'))
  .filter((s) => s.data.cycle.id === entry.id)
  .sort((a, b) => (runOrder.get(a.id) ?? Infinity) - (runOrder.get(b.id) ?? Infinity));
const crumbs = [
  { label: 'Teaching Aids', href: '/slides/' },
  { label: d.title },
];
---
<BaseLayout title={`Teaching Aids — ${d.title}`} description={d.description}
  pageMeta={{ date: d.date, revised: d.revised, license: d.license }}>
  <article class="reading">
    <Breadcrumb crumbs={crumbs} />
    <p class="passage-ref">Teaching Aids</p>
    <h1>{d.title}</h1>

    <Content />

    <ol class="slide-list">
      {slides.map((s) =>
        isVisible(s) ? (
          <li>
            <a href={slideUrl(s.id)}>
              <span class="slide-list__title">{s.data.title}</span>
              <AudienceChip audience={s.data.audience} />
            </a>
          </li>
        ) : (
          <li class="slide-list__upcoming">
            <span class="slide-list__title">{s.data.title}</span>
            <span class="slide-list__date">Coming {formatDate(s.data.scheduled)}</span>
          </li>
        )
      )}
    </ol>

    {d.date && <PageDates date={d.date} revised={d.revised} />}
  </article>
</BaseLayout>
