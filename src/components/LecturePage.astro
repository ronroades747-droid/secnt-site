---
// Shared lecture-page article, used by both lecture routes (section-child
// lectures and the landing-paired lecture, per the June 6, 2026 uniform
// link-and-serve decision) so every lecture page is structurally identical.
// Breadcrumb (Change 6): Commentary › John › John 1:1–3 › [Section title] ›
// Lecture N — section crumb links to the paired Commentary page; for the
// landing-paired lecture the section crumb IS the passage crumb, so the trail
// collapses to Commentary › John › John 1:1–3 › Lecture N.
// Lecture pages carry no Sections sidebar: the back-link is the reading-flow
// exit, the passage crumb the orientation exit, the volume/Commentary crumbs
// the TOC exits.
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BunnyEmbed from './BunnyEmbed.astro';
import PageDates from './PageDates.astro';
import Breadcrumb from './Breadcrumb.astro';
import { commentaryUrl, commentaryPdfUrl, volumeUrl, splitCommentaryId, lectureThumbUrl } from '../lib/site';
import { commentaryPdfName } from '../lib/commentary-pdf.mjs';

interface Props {
  lecture: any; // lectures collection entry
  section: any; // the commentary entry this lecture teaches
}
const { lecture, section } = Astro.props;
const l = lecture.data;
const { Content } = await render(lecture);

const { book, unit, section: sec } = splitCommentaryId(section.id);
const unitId = `${book}/${unit}`;
const vols = await getCollection('volumes');
const bookDisplay = vols.find((v) => v.data.book === book)?.data.bookDisplay ?? book;
const passageLabel = section.data.passageRef
  ? `${bookDisplay} ${section.data.passageRef}`
  : bookDisplay;
// Final crumb: "Lecture N" from the locked title form "Lecture N — [Title]".
const lectureCrumb = 'Lecture';

// The listen-only player (Web Dev Ask "Lecture audio player", 2 Oct 2026):
// the native <audio> element, no player script, preload="none" so nothing is
// fetched until play is pressed. A small script (below) sets the Media
// Session metadata the lock screen and the car's display show. The artwork is
// the lecture's thumbnail, offered only where the file exists. (Until
// 5 October 2026 it also counted the first play as a GoatCounter event.)
const thumbFile = path.join(process.cwd(), 'public', 'lectures', `${section.id}.png`);
const audioArtwork = fs.existsSync(thumbFile) ? lectureThumbUrl(section.id) : '';

const crumbs = [
  { label: 'Commentaries', href: '/commentary/' },
  { label: bookDisplay, href: volumeUrl(book) },
  { label: passageLabel, href: commentaryUrl(unitId) },
  ...(sec ? [{ label: section.data.title, href: commentaryUrl(section.id) }] : []),
  { label: lectureCrumb },
];
---
<BaseLayout title={l.title} description={l.description}
  pageMeta={{ date: l.date, revised: l.revised, license: l.license, passageRef: section.data.passageRef }}>
  <article class="reading reading--wide">
    <Breadcrumb crumbs={crumbs} />
    <h1>{l.title}</h1>
    <BunnyEmbed videoId={l.bunnyVideoId} title={l.title} />

    {l.audioUrl && (
      <section class="lecture-audio" id="listen" aria-label="Listen to the lecture">
        <h2 class="lecture-audio__label">Listen</h2>
        <audio class="lecture-audio__player" controls preload="none" src={l.audioUrl}
          data-media-title={l.title}
          data-media-album={passageLabel}
          data-media-artwork={audioArtwork}></audio>
      </section>
    )}

    <a class="back-link" href={commentaryUrl(section.id)}>← Read the commentary: {section.data.title}</a>

    <ul class="lecture-resources">
      {l.youtubeUrl && <li><a href={l.youtubeUrl} rel="noopener">Watch on YouTube</a></li>}
      <li><a href={commentaryPdfUrl(section.id)} download={commentaryPdfName(section.id)}>Download the commentary (PDF)</a></li>
      {l.slidesPdf && <li><a href={l.slidesPdf}>Download slides (PDF)</a></li>}
      {l.duration && l.duration !== '00:00' && <li>Runtime: {l.duration}</li>}
    </ul>

    <Content />
    <PageDates date={l.date} revised={l.revised} />
  </article>
</BaseLayout>

<script>
  // Label the lock screen. The `play` event covers every route a play can
  // take: the native controls, the lock screen, the car.
  const artist = "Deep in God's Word — SECNT";
  for (const audio of document.querySelectorAll<HTMLAudioElement>('audio.lecture-audio__player')) {
    audio.addEventListener('play', () => {
      const d = audio.dataset;
      if ('mediaSession' in navigator && 'MediaMetadata' in window) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: d.mediaTitle ?? '',
          artist,
          album: d.mediaAlbum ?? '',
          artwork: d.mediaArtwork
            ? [{ src: new URL(d.mediaArtwork, location.href).href, sizes: '640x360', type: 'image/png' }]
            : [],
        });
      }
    });
  }
</script>
