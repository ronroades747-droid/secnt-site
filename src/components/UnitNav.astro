---
// Persistent unit navigation (sections sidebar): an up-and-out "Contents"
// link to the volume landing, then the unit landing ("Introduction") plus
// every PUBLISHED section, the current page in gold. Sections are still
// grouped by segment (for ordering and inter-group separation), but the
// segment subheads are not rendered — each section title now carries its own
// segment prefix (e.g. "The Text: …", "Architecture: …"), so a subhead would
// just say the word twice. The grouping survives as a hairline rule between
// segments. This is a pure reading spine — the paired-lecture link lives at
// the TOP of each Commentary page (in the article header), not in the rail.
//
// Count- and draft-aware via isVisible. Shows the "more to come" note (driven
// by the landing's passageComplete) at the foot while the passage is in
// progress. Mobile: the nav stacks above the article as one closed control
// (Release D, below); desktop: the sidebar scrolls independently when it
// exceeds the viewport.
import { getCollection } from 'astro:content';
import { commentaryUrl, isVisible, SEGMENT_ORDER, SEGMENT_OF, volumeUrl, splitCommentaryId } from '../lib/site';

interface Props {
  unitId: string; // e.g. "john/1-1-to-3"
  currentId?: string; // section id, or undefined on the landing
}
const { unitId, currentId } = Astro.props;

const all = await getCollection('commentary');
const landing = all.find((e) => e.id === unitId);
const sections = all
  .filter((e) => e.id.startsWith(unitId + '/') && isVisible(e))
  .sort((a, b) => a.data.sectionNumber - b.data.sectionNumber);

type Item = { id: string; url: string; label: string };
const groups = new Map<string, Item[]>();
const add = (segment: string, item: Item) => {
  if (!groups.has(segment)) groups.set(segment, []);
  groups.get(segment)!.push(item);
};

if (landing && isVisible(landing)) {
  add(SEGMENT_OF['unit-landing'], {
    id: landing.id,
    url: commentaryUrl(landing.id),
    label: 'Introduction',
  });
}
for (const s of sections) {
  add(SEGMENT_OF[s.data.sectionType] ?? 'Exegesis', {
    id: s.id,
    url: commentaryUrl(s.id),
    label: s.data.title,
  });
}

// Segments render in canonical order; empty segments are skipped, so the
// sidebar grows segment by segment as pairs publish.
const orderedGroups = SEGMENT_ORDER.filter((seg) => groups.has(seg)).map(
  (seg) => ({ segment: seg, items: groups.get(seg)! })
);

const current = currentId ?? unitId;
const showMore = landing ? landing.data.passageComplete !== true : true;
const hasAny = orderedGroups.length > 0;
const count = orderedGroups.reduce((n, g) => n + g.items.length, 0);
// Up-and-out target: the volume landing, which lists this book's passages.
const contentsUrl = volumeUrl(splitCommentaryId(unitId).book);
---
{hasAny && (
  <nav class="unit-nav" aria-label="Sections in this unit">
    {/* Release D (Ask §7, measure 1; the Editor's ruling 24 of 12 Nov 2026):
        on a phone the list is ONE CLOSED CONTROL above the title, "Sections
        in this unit (N)", opening on a tap, where it was a box up to 45vh
        tall ahead of the title. N counts the entries the list holds, the
        Introduction included. On the desktop (64rem and wider) the sidebar is
        unchanged: the script below opens the control there before the page
        is painted, and the stylesheet hides its summary, so the list reads
        exactly as before. Without scripts the control simply starts closed
        on every screen and opens on a click. */}
    <details class="unit-nav__control" data-unit-nav>
      <summary class="unit-nav__summary">Sections in this unit ({count})</summary>
      <div class="unit-nav__sections">
        <a class="unit-nav__up" href={contentsUrl}>&larr; Contents</a>
        {orderedGroups.map((g) => (
          <div class="unit-nav__segment">
            <ol>
              {g.items.map((it) => (
                <li>
                  {it.id === current ? (
                    <span class="unit-nav__current" aria-current="page">{it.label}</span>
                  ) : (
                    <a href={it.url}>{it.label}</a>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))}
        {showMore && <p class="unit-nav__more">More to come; check back soon.</p>}
      </div>
    </details>
    <script is:inline>
      (function () {
        var d = document.currentScript && document.currentScript.previousElementSibling;
        if (!d || !d.hasAttribute('data-unit-nav')) return;
        var wide = window.matchMedia('(min-width: 64rem)');
        var sync = function () { d.open = wide.matches; };
        sync();
        if (wide.addEventListener) wide.addEventListener('change', sync);
      })();
    </script>
  </nav>
)}
