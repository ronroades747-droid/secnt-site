---
import { SITE, canonical } from '../lib/site';
interface Props {
  title: string;
  description?: string;
  datePublished?: Date;
  dateModified?: Date;
  /** Keep this page out of search results (a dated version; Release C, Q5). */
  noindex?: boolean;
  /**
   * Google Scholar tags (Release C, Ask §5.1): citation_title,
   * citation_author, citation_publication_date, citation_pdf_url.
   */
  scholar?: { title: string; publicationDate: Date; pdfUrl?: string };
}
const { title, description, datePublished, dateModified, noindex, scholar } = Astro.props;
const scholarDate = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '/');
const canonicalURL = canonical(Astro.url.pathname);
const fullTitle = title === SITE.wordmark ? title : `${title} — ${SITE.wordmark}`;

// schema.org Article dates, emitted machine-side per the Publication &
// Revision Dates standard so citation managers and search-freshness signals
// read the pair. Only emitted for dated content pages (datePublished present).
// dateModified falls back to datePublished when the page has never been
// revised. `<` is escaped so a value containing it can never break the script.
const iso = (d: Date) => d.toISOString().slice(0, 10);
const jsonLd = datePublished
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      author: { '@type': 'Person', name: SITE.author },
      datePublished: iso(datePublished),
      dateModified: iso(dateModified ?? datePublished),
      license: SITE.licenseUrl,
      url: canonicalURL,
    }).replace(/</g, '\\u003c')
  : null;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonicalURL} />

<meta name="author" content={SITE.author} />
{noindex && <meta name="robots" content="noindex" />}
{scholar && (
  <>
    <meta name="citation_title" content={scholar.title} />
    <meta name="citation_author" content="Roades, Ronald E." />
    <meta name="citation_publication_date" content={scholarDate(scholar.publicationDate)} />
    {scholar.pdfUrl && <meta name="citation_pdf_url" content={new URL(scholar.pdfUrl, SITE.origin).href} />}
  </>
)}
<meta name="license" content={SITE.licenseName} />

<!-- Open Graph -->
<meta property="og:type" content="article" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonicalURL} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
